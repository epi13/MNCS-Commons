mncs 0.18;

module tests.native_obligation_contract_probe;

use mncs.commons.family.obligations.v1 as contracts;

record ContractProbe {
    active: bool,
    reference_only_excluded: bool,
    new_execution_required: bool,
    native_test_executor: bool
}

fn all() -> (result: ContractProbe) {
    return ContractProbe {
        active: contracts.lifecycle_is_active(contracts.ObligationLifecycle.permanent),
        reference_only_excluded: contracts.lifecycle_is_ordinary_excluded(contracts.ObligationLifecycle.reference_only),
        new_execution_required: contracts.status_requires_execution(contracts.ObligationStatus.new_execution_required),
        native_test_executor: contracts.executor_is_native_test(contracts.ExecutorKind.native_first_class_test)
    };
}
