mncs 0.18;

module tests.native_family_change_probe;

use mncs.commons.family.change.v1 as law;

record ChangeProbe {
    draft_observes: bool,
    draft_cannot_establish: bool,
    observed_validates: bool,
    validated_establishes: bool,
    established_publishes: bool,
    established_supersedes: bool,
    published_terminal: bool,
    conflicted_revalidates: bool,
    invalid_terminal: bool,
    converged_current: bool,
    incompatible_class: bool,
    applied_pass_current: bool,
    applied_fail_semantic: bool,
    applied_unknown_pending: bool,
    occupied_class: bool,
    choice_semantic: bool,
    unknown_op_semantic: bool,
    provider_blocked: bool,
    no_verification_unknown: bool,
    clean_reconcilable: bool,
    gate_proceeds: bool,
    gate_defers_preimage: bool,
    gate_defers_claim: bool,
    gate_escalates_dirt: bool,
    gate_escalates_budget: bool,
    gate_defers_occupied: bool,
    gate_escalates_unknown: bool,
    adopt_advances: bool,
    post_repair_pass_adopts: bool,
    old_pass_waits: bool,
    old_fail_waits: bool,
    renewed_fail_refuses: bool,
    adopt_refuses_stale_version: bool,
    adopt_refuses_fail: bool,
    adopt_refuses_regression: bool,
    transform_admits: bool,
    transform_refuses_unknown_op: bool,
    transform_refuses_preimage: bool,
    transform_refuses_authority: bool,
    revisit_replan_immediate: bool,
    revisit_gated_backoff: bool,
    revisit_refuses_budget: bool,
    contributor_session_live: bool,
    contributor_dead_expired: bool
}

fn all() -> (result: ChangeProbe) {
    return ChangeProbe {
        draft_observes: law.lifecycle_legal(0, 1),
        draft_cannot_establish: !law.lifecycle_legal(0, 3),
        observed_validates: law.lifecycle_legal(1, 2),
        validated_establishes: law.lifecycle_legal(2, 3),
        established_publishes: law.lifecycle_legal(3, 4),
        established_supersedes: law.lifecycle_legal(3, 5),
        published_terminal: !law.lifecycle_legal(4, 5),
        conflicted_revalidates: law.lifecycle_legal(7, 2),
        invalid_terminal: !law.lifecycle_legal(8, 2),
        converged_current: law.class_code(law.classify_consumer(0, 1, 0, 0, 0, 1, 1, 1)) == 0,
        incompatible_class: law.class_code(law.classify_consumer(1, 0, 0, 0, 0, 1, 1, 1)) == 7,
        applied_pass_current: law.class_code(law.classify_consumer(1, 1, 3, 0, 0, 1, 1, 1)) == 0,
        applied_fail_semantic: law.class_code(law.classify_consumer(1, 1, 2, 0, 0, 1, 1, 1)) == 2,
        applied_unknown_pending: law.class_code(law.classify_consumer(1, 1, 1, 0, 0, 1, 1, 1)) == 4,
        occupied_class: law.class_code(law.classify_consumer(1, 1, 0, 1, 0, 1, 1, 1)) == 3,
        choice_semantic: law.class_code(law.classify_consumer(1, 1, 0, 0, 1, 1, 1, 1)) == 2,
        unknown_op_semantic: law.class_code(law.classify_consumer(1, 1, 0, 0, 0, 0, 1, 1)) == 2,
        provider_blocked: law.class_code(law.classify_consumer(1, 1, 0, 0, 0, 1, 0, 1)) == 5,
        no_verification_unknown: law.class_code(law.classify_consumer(1, 1, 0, 0, 0, 1, 1, 0)) == 6,
        clean_reconcilable: law.class_code(law.classify_consumer(1, 1, 0, 0, 0, 1, 1, 1)) == 1,
        gate_proceeds: law.gate_code(law.gate_repair(1, 1, 1, 1, 0, 0, 3)) == 0,
        gate_defers_preimage: law.gate_code(law.gate_repair(1, 0, 1, 1, 0, 0, 3)) == 1,
        gate_defers_claim: law.gate_code(law.gate_repair(1, 1, 1, 0, 0, 0, 3)) == 1,
        gate_escalates_dirt: law.gate_code(law.gate_repair(1, 1, 1, 1, 1, 0, 3)) == 2,
        gate_escalates_budget: law.gate_code(law.gate_repair(1, 1, 1, 1, 0, 3, 3)) == 2,
        gate_defers_occupied: law.gate_code(law.gate_repair(3, 1, 1, 1, 0, 0, 3)) == 1,
        gate_escalates_unknown: law.gate_code(law.gate_repair(6, 1, 1, 1, 0, 0, 3)) == 2,
        post_repair_pass_adopts: law.adopt_code(law.adopt_post_repair(5, 5, 1, 7, 9, 1)) == 0,
        old_pass_waits: law.adopt_code(law.adopt_post_repair(5, 5, 1, 7, 9, 0)) == 1,
        old_fail_waits: law.adopt_code(law.adopt_post_repair(5, 5, 2, 7, 9, 0)) == 1,
        renewed_fail_refuses: law.adopt_code(law.adopt_post_repair(5, 5, 2, 7, 9, 1)) == 1,
        adopt_advances: law.adopt_code(law.adopt_convergence(5, 5, 1, 7, 9)) == 0,
        adopt_refuses_stale_version: law.adopt_code(law.adopt_convergence(5, 6, 1, 7, 9)) == 1,
        adopt_refuses_fail: law.adopt_code(law.adopt_convergence(5, 5, 0, 7, 9)) == 1,
        adopt_refuses_regression: law.adopt_code(law.adopt_convergence(5, 5, 1, 9, 7)) == 2,
        transform_admits: law.transform_verdict_code(law.transform_admit(0, 1, 1, 1, 1)) == 0,
        transform_refuses_unknown_op: law.transform_verdict_code(law.transform_admit(9, 1, 1, 1, 1)) == 1,
        transform_refuses_preimage: law.transform_verdict_code(law.transform_admit(0, 0, 1, 1, 1)) == 1,
        transform_refuses_authority: law.transform_verdict_code(law.transform_admit(0, 1, 0, 1, 1)) == 1,
        revisit_replan_immediate: law.revisit_due(0, 0, 3, 0),
        revisit_gated_backoff: law.revisit_due(2, 1, 3, 1) && !law.revisit_due(2, 1, 3, 0),
        revisit_refuses_budget: !law.revisit_due(2, 3, 3, 1),
        contributor_session_live: law.contributor_live(1, 0),
        contributor_dead_expired: !law.contributor_live(0, 0)
    };
}
