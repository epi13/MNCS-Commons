mncs 0.10;

// commons.mesh.interest — interest-projection matching for the Commons Mesh.
//
// A node interested in PTX compiler behavior must not retain every unrelated
// record. This module is the portable matching kernel behind InterestFilter:
// given a record's kind, outcome, and lifecycle state plus an explicit
// subscription, decide membership deterministically.
//
// Textual names (kind strings, project paths, contract URNs) stay on the
// host side: MNCS profiles have no bounded string-equality primitive for
// open vocabularies (see MESH_PRESSURE_LEDGER.md, STDLIB_GAP-01). The host
// projects names to the closed discriminants below; this module owns the
// Boolean combination law, which is where silent over/under-matching bugs
// would hide. Discriminant tables are part of the contract:
//
//   Kind:      0=Finding 1=Claim 2=Replication 3=Observation
//              4=Question 5=WorkRequest 6=Other
//   Outcome:   0=PASS 1=FAIL 2=UNKNOWN
//   Lifecycle: 0=proposed 1=reproduced 2=verified 3=accepted
//              4=disputed 5=other
//
// A subscription is six kind flags, three outcome flags, and a minimum
// lifecycle rank (records below the rank are excluded). Lifecycle rank
// follows mesh promotion order shifted by one so no subtraction is needed:
// other/disputed(0) < proposed(1) < reproduced(2) < verified(3)
// < accepted(4). A minimum rank of 0 matches everything; 1 and above
// exclude disputed/other records.
//
// Source-profile notes: profiles have no `!` operator and no unary minus,
// so negation is if/else (as in mncs.core.logic.v1) and ranks avoid
// negative literals entirely (comparison-only code carries no
// integer-overflow obligation).
//
// Open-vocabulary names reach the sibling module
// commons.mesh.interest_named as bounded byte views; its tables
// (P-COMMONS-07, via mncs.std.text_map.v1) project them to the closed
// discriminants above. Unknown names fall back to the `Other`
// discriminants (6 / 9 / 5), which the law never matches: unknown names
// stay inert, never silently included. Table rows are machine-checked
// against the host materialization (see test_mesh_interop table-authority
// coverage): the .mncs literals are normative.
module commons.mesh.interest;

fn kind_wanted(kind: i64, want_finding: bool, want_claim: bool, want_replication: bool, want_observation: bool, want_question: bool, want_work: bool) -> (result: bool) {
    if kind == 0 {
        return want_finding;
    }
    if kind == 1 {
        return want_claim;
    }
    if kind == 2 {
        return want_replication;
    }
    if kind == 3 {
        return want_observation;
    }
    if kind == 4 {
        return want_question;
    }
    if kind == 5 {
        return want_work;
    }
    return false;
}

fn outcome_wanted(outcome: i64, want_pass: bool, want_fail: bool, want_unknown: bool) -> (result: bool) {
    if outcome == 0 {
        return want_pass;
    }
    if outcome == 1 {
        return want_fail;
    }
    if outcome == 2 {
        return want_unknown;
    }
    return false;
}

fn lifecycle_rank(state: i64) -> (result: i64) {
    if state == 0 {
        return 1;
    }
    if state == 1 {
        return 2;
    }
    if state == 2 {
        return 3;
    }
    if state == 3 {
        return 4;
    }
    return 0;
}

// Executable entry point: full membership decision.
fn candidate_matches(kind: i64, outcome: i64, state: i64, want_finding: bool, want_claim: bool, want_replication: bool, want_observation: bool, want_question: bool, want_work: bool, want_pass: bool, want_fail: bool, want_unknown: bool, min_rank: i64) -> (result: bool) {
    let kind_ok: bool = kind_wanted(kind, want_finding, want_claim, want_replication, want_observation, want_question, want_work);
    if kind_ok {
        let outcome_ok: bool = outcome_wanted(outcome, want_pass, want_fail, want_unknown);
        if outcome_ok {
            return lifecycle_rank(state) >= min_rank;
        }
        return false;
    }
    return false;
}

// Open-vocabulary name tables live in commons.mesh.interest_named (separate
// module: textmap lookups carry iteration-cost obligations, and the split
// keeps this module's PASS gate meaningful — see that file's header).

// A dimension imposes nothing when the subscription leaves it empty;
// otherwise the record must satisfy it.
fn dim_pass(has: bool, ok: bool) -> (result: bool) {
    if has {
        return ok;
    }
    return true;
}

// A gate admits everything unless the subscription enables it.
fn gate_pass(gate: bool, holds: bool) -> (result: bool) {
    if gate {
        return holds;
    }
    return true;
}

// Executable entry point: the full production membership law behind
// InterestFilter.matches. The host projects the record and the filter to
// discriminants plus per-dimension (has, ok) pairs (capability shell);
// every combination decision runs here. kind_code follows the kind table
// (unknown names are code 6 and never match a restricted kind dimension:
// unknown vocabulary stays inert, never silently included). One deliberate
// closed-world tightening versus the legacy string-exact path: a filter
// that names kinds outside the closed six matches nothing, where the old
// path exact-matched unknown record kinds. All other dimensions decide
// exactly as before.
fn candidate_matches_full(kind_code: i64, want_finding: bool, want_claim: bool, want_replication: bool, want_observation: bool, want_question: bool, want_work: bool, has_kinds: bool, has_projects: bool, projects_ok: bool, has_contracts: bool, contracts_ok: bool, has_producers: bool, producers_ok: bool, has_outcomes: bool, outcomes_ok: bool, has_states: bool, states_ok: bool, has_reltypes: bool, reltypes_ok: bool, has_labels: bool, labels_ok: bool, record_id_hit: bool, open_work_only: bool, is_open_work: bool, promotion_relevant: bool, is_promo_relevant: bool) -> (result: bool) {
    if record_id_hit {
        return true;
    }
    let kind_ok: bool = kind_wanted(kind_code, want_finding, want_claim, want_replication, want_observation, want_question, want_work);
    return dim_pass(has_kinds, kind_ok) && dim_pass(has_projects, projects_ok) && dim_pass(has_contracts, contracts_ok) && dim_pass(has_producers, producers_ok) && dim_pass(has_outcomes, outcomes_ok) && dim_pass(has_states, states_ok) && dim_pass(has_reltypes, reltypes_ok) && dim_pass(has_labels, labels_ok) && gate_pass(open_work_only, is_open_work) && gate_pass(promotion_relevant, is_promo_relevant);
}
