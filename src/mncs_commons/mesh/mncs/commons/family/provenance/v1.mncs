mncs 0.18;
module mncs.commons.family.provenance.v1;

// Content identities exclude observation timestamps and filesystem addresses.
// Unknown required inputs cannot establish execution or evidence equivalence.
fn digest_equal(a: [byte; 32], b: [byte; 32]) -> (same: bool) {
    iterate i over a carrying equal: bool = true {
        next equal = equal && a[i] == b[i];
    }
    return equal;
}

// unknown=0, current=1, stale=2. Intact means actual artifact bytes and
// the receipt core were checked, not merely that a path exists.
fn artifact_state(expected: [byte; 32], built: [byte; 32],
                  required_known: u64, receipt_present: u64,
                  artifact_intact: u64) -> (state: u64) {
    if required_known != 1 { return 0; }
    if receipt_present != 1 || artifact_intact != 1 { return 2; }
    if !digest_equal(expected, built) { return 2; }
    return 1;
}

// Receipt equality is necessary but not a replacement for Test/Debug gates.
// Domain owners supply completeness and result admissibility independently.
fn evidence_applicable(required: [byte; 32], established: [byte; 32],
                       required_known: u64, established_known: u64,
                       domain_admitted: u64) -> (reusable: bool) {
    return required_known == 1 && established_known == 1 &&
           domain_admitted == 1 && digest_equal(required, established);
}
