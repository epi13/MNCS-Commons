mncs 0.18;

// mncs.commons.family.change.v1
//
// Native law for the family shared semantic workspace: working-change
// lifecycle, consumer drift classification, repair gating, convergence
// adoption, transform admission, and revisit eligibility.
//
// This is NOT the Record Spine ChangeSet
// (`commons.mncs.dev/changeset/v0alpha1`), which coordinates EVIDENCE for
// promotion decisions. A family change is a producer WORKING change with
// semantic subjects, typed operations, and consumer impact; it may LINK
// to Record Spine ChangeSets as coordination evidence, but the two
// records answer different questions and must never be conflated.
//
// Boundary: the host observes all string/identity/digest facts
// (repositories, revisions, subjects, paths, claims) and projects them
// to finite codes. This module combines code facts into verdicts; it
// never invents a fact. All functions take u64/i64 only, matching the
// established `mncs call` integer boundary.
//
// Code tables (host mirrors these exactly):
//
// ChangeState:
//   0 draft        1 observed      2 validated     3 established
//   4 published    5 superseded    6 abandoned     7 conflicted
//   8 invalid
//
// ConsumerClass:
//   0 current               1 reconcilable          2 semantic_required
//   3 occupied              4 pending_verification  5 blocked
//   6 unknown               7 incompatible
//
// Gate (deliberately aligned with mncs.automation projection Gate):
//   0 proceed   1 defer   2 escalate
//
// Adopt (deliberately aligned with mncs.automation AdoptReason):
//   0 adopted   1 stale_regeneration   2 regression_refused
//
// RepairState:
//   0 no_repair   1 applied_unknown   2 applied_fail   3 applied_pass
//
// Verdict (aligned with automation trigger positions):
//   0 failed   1 passed   2 unknown
//
// TransformOp:
//   0 set_json_field   1 replace_span   2 run_capability
//   3+ unknown (always refused)
//
// DeferReason:
//   0 replan   1 claim_required   2 occupied   3 provider_unavailable
//   4 awaiting_verdict
//
// A future Sol pass should unify Gate/Adopt/Verdict codes into one
// Commons-owned decision-code registry; today they match by convention.
module mncs.commons.family.change.v1;

enum ChangeState {
    draft,
    observed,
    validated,
    established,
    published,
    superseded,
    abandoned,
    conflicted,
    invalid
}

enum ConsumerClass {
    current,
    reconcilable,
    semantic_required,
    occupied,
    pending_verification,
    blocked,
    unknown,
    incompatible
}

enum Gate { proceed, defer, escalate }

enum Adopt { adopted, stale_regeneration, regression_refused }

enum RepairState { no_repair, applied_unknown, applied_fail, applied_pass }

enum Verdict { failed, passed, unknown }

enum TransformOp { set_json_field, replace_span, run_capability }

enum TransformVerdict { admit, refuse }

enum DeferReason {
    replan,
    claim_required,
    occupied,
    provider_unavailable,
    awaiting_verdict
}

fn family_change_schema() -> (result: [byte; up_to 32]) {
    return [109, 110, 99, 115, 46, 102, 97, 109, 105, 108, 121, 45, 99, 104, 97, 110, 103, 101, 47, 49];
}

// --- lifecycle ---------------------------------------------------------

fn state_code(state: ChangeState) -> (result: u64) {
    return match state {
        draft => 0,
        observed => 1,
        validated => 2,
        established => 3,
        published => 4,
        superseded => 5,
        abandoned => 6,
        conflicted => 7,
        invalid => 8,
    };
}

// Legal working-change transitions. Draft work is visible but never
// authoritative; only established changes drive consumer convergence;
// published/superseded/abandoned/invalid are terminal.
fn lifecycle_legal(from: u64, to: u64) -> (result: bool) {
    if from == 0 {
        return to == 1 || to == 6 || to == 8;
    }
    if from == 1 {
        return to == 2 || to == 5 || to == 6 || to == 8;
    }
    if from == 2 {
        return to == 3 || to == 5 || to == 6 || to == 7 || to == 8;
    }
    if from == 3 {
        return to == 4 || to == 5 || to == 7;
    }
    if from == 7 {
        return to == 2 || to == 5 || to == 6;
    }
    return false;
}

// --- consumer classification -------------------------------------------

fn class_code(class: ConsumerClass) -> (result: u64) {
    return match class {
        current => 0,
        reconcilable => 1,
        semantic_required => 2,
        occupied => 3,
        pending_verification => 4,
        blocked => 5,
        unknown => 6,
        incompatible => 7,
    };
}

// Classify one consumer against one established change. All inputs are
// host-observed 0/1 facts except repair (RepairState code) and drift
// (0 converged, 1 behind). Classification describes the subject, not
// this session's actionability: claim facts belong to the gate.
fn classify_consumer(
    drift: u64,
    compatible: u64,
    repair: u64,
    occupied: u64,
    semantic_choice: u64,
    ops_known: u64,
    provider_available: u64,
    verification_known: u64
) -> (result: ConsumerClass) {
    if drift == 0 {
        return ConsumerClass.current;
    }
    if compatible == 0 {
        return ConsumerClass.incompatible;
    }
    if repair == 3 {
        return ConsumerClass.current;
    }
    if repair == 2 {
        return ConsumerClass.semantic_required;
    }
    if repair == 1 {
        return ConsumerClass.pending_verification;
    }
    if occupied == 1 {
        return ConsumerClass.occupied;
    }
    if semantic_choice == 1 {
        return ConsumerClass.semantic_required;
    }
    if ops_known == 0 {
        return ConsumerClass.semantic_required;
    }
    if provider_available == 0 {
        return ConsumerClass.blocked;
    }
    if verification_known == 0 {
        return ConsumerClass.unknown;
    }
    return ConsumerClass.reconcilable;
}

// --- repair gate ---------------------------------------------------------

// One bounded request for independent consumer observations. Ordering and
// scalar law are identical; batching never mixes domain authorities.
fn classify_consumers(facts: [[u64; 8]; up_to 32]) -> (result: [u64; up_to 32]) {
    iterate i over facts carrying codes: [u64; 32] = [0; 32] {
        let row: [u64; 8] = facts[i];
        next codes = replace(codes, i, class_code(classify_consumer(
            row[0], row[1], row[2], row[3], row[4], row[5], row[6], row[7])));
    }
    return codes[0..facts.len];
}

fn gate_code(gate: Gate) -> (result: u64) {
    return match gate {
        proceed => 0,
        defer => 1,
        escalate => 2,
    };
}

// Gate a pending repair for THIS session. The host gates only
// non-current classes; gating current defers defensively (no work).
// attempts_used >= attempts_max escalates: bounded budgets never spin.
fn gate_repair(
    class: u64,
    preimage_ok: u64,
    generation_current: u64,
    claim_live: u64,
    foreign_dirt: u64,
    attempts_used: u64,
    attempts_max: u64
) -> (result: Gate) {
    if class == 0 {
        return Gate.defer;
    }
    if class == 1 {
        if foreign_dirt == 1 {
            return Gate.escalate;
        }
        if attempts_used >= attempts_max {
            return Gate.escalate;
        }
        if preimage_ok == 0 {
            return Gate.defer;
        }
        if generation_current == 0 {
            return Gate.defer;
        }
        if claim_live == 0 {
            return Gate.defer;
        }
        return Gate.proceed;
    }
    if class == 3 {
        return Gate.defer;
    }
    if class == 4 {
        return Gate.defer;
    }
    if class == 5 {
        return Gate.defer;
    }
    return Gate.escalate;
}

// --- convergence adoption -----------------------------------------------

fn adopt_code(adopt: Adopt) -> (result: u64) {
    return match adopt {
        adopted => 0,
        stale_regeneration => 1,
        regression_refused => 2,
    };
}

// Adopt a converged generation into the reconciliation row. The row
// advances only when the version observed at plan time still holds,
// the repair verdict is PASS, and the generation never regresses.
fn adopt_convergence(
    version_seen: u64,
    version_now: u64,
    verdict: u64,
    observed_gen: u64,
    canonical_gen: u64
) -> (result: Adopt) {
    if version_now != version_seen {
        return Adopt.stale_regeneration;
    }
    if verdict != 1 {
        return Adopt.stale_regeneration;
    }
    if observed_gen > canonical_gen {
        return Adopt.regression_refused;
    }
    return Adopt.adopted;
}

// A repair cannot adopt a proof captured before its effects. The host supplies
// exact before/after evidence identity facts; domain admission remains here.
fn adopt_post_repair(
    version_seen: u64,
    version_now: u64,
    verdict: u64,
    observed_gen: u64,
    canonical_gen: u64,
    proof_renewed: u64
) -> (result: Adopt) {
    if proof_renewed != 1 {
        return Adopt.stale_regeneration;
    }
    return adopt_convergence(version_seen, version_now, verdict, observed_gen, canonical_gen);
}

// --- transform admission --------------------------------------------------

fn op_code(op: TransformOp) -> (result: u64) {
    return match op {
        set_json_field => 0,
        replace_span => 1,
        run_capability => 2,
    };
}

fn transform_verdict_code(verdict: TransformVerdict) -> (result: u64) {
    return match verdict {
        admit => 0,
        refuse => 1,
    };
}

// Admit one typed transform operation. Unknown operations, preimage
// mismatch, missing authority, unbounded paths, or unconfined outputs
// refuse: the host must escalate, never improvise.
fn transform_admit(
    op: u64,
    preimage_ok: u64,
    authority_ok: u64,
    paths_bounded: u64,
    output_confined: u64
) -> (result: TransformVerdict) {
    if op > 2 {
        return TransformVerdict.refuse;
    }
    if preimage_ok == 0 {
        return TransformVerdict.refuse;
    }
    if authority_ok == 0 {
        return TransformVerdict.refuse;
    }
    if paths_bounded == 0 {
        return TransformVerdict.refuse;
    }
    if output_confined == 0 {
        return TransformVerdict.refuse;
    }
    return TransformVerdict.admit;
}

// --- revisit -----------------------------------------------------------------

fn defer_reason_code(reason: DeferReason) -> (result: u64) {
    return match reason {
        replan => 0,
        claim_required => 1,
        occupied => 2,
        provider_unavailable => 3,
        awaiting_verdict => 4,
    };
}

// A deferred row is eligible for reconsideration when its budget
// remains and, for externally-gated reasons, the host's backoff says
// so. Replan is immediate: the world already moved.
fn revisit_due(
    reason: u64,
    attempts_used: u64,
    attempts_max: u64,
    backoff_eligible: u64
) -> (result: bool) {
    if attempts_used >= attempts_max {
        return false;
    }
    if reason == 0 {
        return true;
    }
    if reason > 4 {
        return false;
    }
    return backoff_eligible == 1;
}

// --- contributor liveness -------------------------------------------------------

// A contributor record is live when its session is live; stale records
// are retained (never auto-deleted) so provenance survives.
fn contributor_live(session_live: u64, within_ttl: u64) -> (result: bool) {
    if session_live == 1 {
        return true;
    }
    return within_ttl == 1;
}
