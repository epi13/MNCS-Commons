    selected_repositories: [[byte; up_to 256]; up_to 64],
    selected_check_identities: [[byte; 32]; up_to 64],
    required_evidence: [[byte; up_to 128]; up_to 16],
    verdict: ContractFamilyVerdict,
    sufficient: bool
}

fn verification_plan_identity_material(plan: VerificationPlan) -> (result: VerificationPlanIdentityMaterial) {
    return VerificationPlanIdentityMaterial {
        schema_version: plan.schema_version,
        source: plan.source,
        impact: plan.impact,
        selection: plan.selection,
        proof: plan.proof,
        provenance: plan.provenance
    };
}

fn semantic_impact_identity_material(impact: SemanticImpactContract) -> (result: SemanticImpactIdentityMaterial) {
    return SemanticImpactIdentityMaterial {
        graph_identity: impact.graph_identity,
        roots: impact.roots,
        affected_count: impact.affected_count,
        direct_dependents: impact.direct_dependents,
        test_identities: impact.test_identities,
        risk_flags: impact.risk_flags,
        complete: impact.complete,
        limitations: impact.limitations,
        cross_repository: impact.cross_repository
    };
}

fn test_inventory_identity_material(inventory: TestInventoryContract) -> (result: TestInventoryIdentityMaterial) {
    return TestInventoryIdentityMaterial {
        subject_identity: inventory.subject_identity,
        subject_fingerprint: inventory.subject_fingerprint,
        test_case_identities: inventory.test_case_identities
    };
}

fn semantic_edge_identity_material(edge: SemanticEdgeContract) -> (result: SemanticEdgeIdentityMaterial) {
    return SemanticEdgeIdentityMaterial {
        producer_repository: edge.producer_repository,
        consumer_repository: edge.consumer_repository,
        contract_identity: edge.contract_identity,
        contract_revision: edge.contract_revision,
        consuming_identity: edge.consuming_identity,
        provenance: edge.provenance,
        fingerprint: edge.fingerprint,
        consumer_manifest_identity: edge.consumer_manifest_identity,
        check_identity: edge.check_identity,
        selected_test_identities: edge.selected_test_identities
    };
}

fn provider_declaration_identity_material(declaration: ProviderDeclarationContract) -> (result: ProviderDeclarationIdentityMaterial) {
    return ProviderDeclarationIdentityMaterial {
        repository_id: declaration.repository_id,
        provider_identity: declaration.provider_identity,
        interface_identity: declaration.interface_identity,
        revision_identity: declaration.revision_identity,
        source_identity: declaration.source_identity,
        inventory_identity: declaration.inventory_identity,
        revision: declaration.revision,
        capabilities: declaration.capabilities
