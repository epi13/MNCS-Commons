        provider_revision_identity: result_value.provider_revision_identity,
        interface_identity: result_value.interface_identity,
        inventory_identity: result_value.inventory_identity,
        test_result_identity: result_value.test_result_identity,
        execution_identity: result_value.execution_identity,
        evidence_identity: result_value.evidence_identity,
        verdict: result_value.verdict
    };
}

fn receipt_identity_material(receipt: ReceiptContract) -> (result: ReceiptIdentityMaterial) {
    return ReceiptIdentityMaterial {
        plan_identity: receipt.plan_identity,
        graph_identity: receipt.graph_identity,
        edge_identity: receipt.edge_identity,
        source_identity: receipt.source_identity,
        contract_identity: receipt.contract_identity,
        consumer_identity: receipt.consumer_identity,
        provider_identity: receipt.provider_identity,
        provider_revision_identity: receipt.provider_revision_identity,
        interface_identity: receipt.interface_identity,
        inventory_identity: receipt.inventory_identity,
        test_result_identity: receipt.test_result_identity,
        check_result_identity: receipt.check_result_identity,
        execution_identity: receipt.execution_identity,
        evidence_identity: receipt.evidence_identity,
        profile_identity: receipt.profile_identity,
        verdict: receipt.verdict
