}

fn test_result_identity_material(result_value: TestResultContract) -> (result: TestResultIdentityMaterial) {
    return TestResultIdentityMaterial {
        provider_identity: result_value.provider_identity,
        provider_revision_identity: result_value.provider_revision_identity,
        interface_identity: result_value.interface_identity,
        inventory_identity: result_value.inventory_identity,
        execution: result_value.execution,
        selected_test_identities: result_value.selected_test_identities,
        verdict: result_value.verdict,
        failure_code: result_value.failure_code,
        evidence_identity: result_value.evidence_identity
