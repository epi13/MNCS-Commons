record CheckResultIdentityMaterial {
    check_identity: [byte; 32],
    provider_identity: [byte; 32],
    provider_revision_identity: [byte; 32],
    interface_identity: [byte; 32],
    inventory_identity: [byte; 32],
    test_result_identity: [byte; 32],
    execution_identity: [byte; 32],
    evidence_identity: [byte; 32],
    verdict: ContractFamilyVerdict
}

record ReceiptIdentityMaterial {
    plan_identity: [byte; 32],
    graph_identity: [byte; 32],
    edge_identity: [byte; 32],
    source_identity: [byte; 32],
    contract_identity: [byte; 32],
    consumer_identity: [byte; 32],
    provider_identity: [byte; 32],
    provider_revision_identity: [byte; 32],
    interface_identity: [byte; 32],
    inventory_identity: [byte; 32],
    test_result_identity: [byte; 32],
    check_result_identity: [byte; 32],
    execution_identity: [byte; 32],
    evidence_identity: [byte; 32],
    profile_identity: [byte; 32],
    verdict: ContractFamilyVerdict
}

record EvidenceManifestIdentityMaterial {
    test_result_identity: [byte; 32],
    check_result_identity: [byte; 32],
    execution_identity: [byte; 32],
    failure_material: [byte; up_to 1024],
