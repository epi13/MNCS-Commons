{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/commons/v0alpha1.json",
  "title": "MNCS Commons v0alpha1 record or lifecycle event",
  "oneOf": [{"$ref": "#/$defs/record"}, {"$ref": "#/$defs/event"}],
  "$defs": {
    "identity": {"type": "string", "minLength": 1},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "subject", "scope", "statement", "evidence", "dependencies", "affectedContracts", "provenance", "confidence", "security", "lifecycle", "relationships", "details"],
      "properties": {
        "apiVersion": {"const": "commons.mncs.dev/v0alpha1"},
        "kind": {"enum": ["Observation", "Claim", "WorkRequest", "Replication", "Advisory", "Decision"]},
        "contentDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "subject": {"type": "object", "required": ["type", "identity"], "properties": {"type": {"type": "string"}, "identity": {"type": "string"}}, "additionalProperties": true},
        "scope": {"type": "object", "required": ["context"], "properties": {"context": {"type": "object"}, "limitations": {"type": "array", "items": {"type": "string"}}, "reviewAt": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
        "statement": {"type": "object", "required": ["summary"], "properties": {"summary": {"type": "string", "minLength": 1}, "details": {}}, "additionalProperties": true},
        "evidence": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "digest": {"type": "string"}, "relation": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]}}, "additionalProperties": true}},
        "reproduction": {"type": "object", "properties": {"prerequisites": {"type": "array"}, "procedure": {"type": "array"}, "expected": {"type": "array"}}, "additionalProperties": true},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "affectedContracts": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object", "required": ["producer"], "properties": {"producer": {"type": "object", "required": ["type", "id"]}, "sourceRecords": {"type": "array"}, "environment": {"type": "object"}, "ancestry": {"type": "array"}}, "additionalProperties": true},
        "confidence": {"type": "object", "required": ["level", "rationale"], "properties": {"level": {"enum": ["low", "medium", "high", "unreported"]}, "rationale": {"type": "string"}}, "additionalProperties": false},
        "security": {"type": "object", "required": ["sensitivity", "executableAttachments", "instructionsAreUntrusted"], "properties": {"sensitivity": {"enum": ["public", "restricted", "sensitive", "security-sensitive"]}, "executableAttachments": {"type": "boolean"}, "instructionsAreUntrusted": {"const": true}, "requiredExternalAuthority": {"type": "boolean"}}, "additionalProperties": false},
        "lifecycle": {"type": "object", "required": ["initialState"], "properties": {"initialState": {"const": "proposed"}, "reviewWhen": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "relationships": {"type": "array", "items": {"type": "object", "required": ["type", "target"], "properties": {"type": {"type": "string"}, "target": {"type": "string"}}, "additionalProperties": true}},
        "details": {"type": "object"},
        "extensions": {"type": "object"}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["createdAt", "author"],
      "properties": {"recordId": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}, "author": {"type": "object", "required": ["type", "id"]}, "labels": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "target", "transition", "authority", "evidence"],
      "properties": {
        "apiVersion": {"const": "commons.mncs.dev/v0alpha1"},
        "kind": {"const": "LifecycleEvent"},
        "contentDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "target": {"type": "object", "required": ["contentDigest"], "properties": {"contentDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
        "transition": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}, "additionalProperties": false},
        "authority": {"type": "object", "required": ["domain", "actor", "rationale"], "properties": {"domain": {"type": "string"}, "actor": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false},
        "evidence": {"type": "array"},
        "extensions": {"type": "object"}
      }
    }
  }
}
