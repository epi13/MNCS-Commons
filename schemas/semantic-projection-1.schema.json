{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/semantic-projection-1.schema.json",
  "title": "Semantic projection declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "owner",
    "subjects",
    "renderer",
    "output",
    "output_kind",
    "policy",
    "manual_edit_policy",
    "validation",
    "provider_capability",
    "render_argv",
    "inputs",
    "template"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "provider_capability": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "bootstrap_digest": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "mncs.semantic-projection/1"
    },
    "output_kind": {
      "enum": [
        "whole-file",
        "region"
      ]
    },
    "policy": {
      "enum": [
        "ambient-safe",
        "explicit-only"
      ]
    },
    "manual_edit_policy": {
      "const": "protected"
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "render_argv": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "slot",
          "path"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^/.][^/]*$"
          },
          "select": {
            "type": "string",
            "pattern": "^(/.*)?$"
          },
          "format": {
            "enum": [
              "json",
              "utf-8",
              "digest"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "schema_version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "markdown",
            "json",
            "utf-8"
          ]
        },
        "schema": {
          "type": "object"
        },
        "schema_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "path",
            "identity"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "verification": {
      "type": "object"
    },
    "admit": {
      "type": "object"
    },
    "defer_bound": {
      "type": "integer",
      "minimum": 0
    }
  }
}
