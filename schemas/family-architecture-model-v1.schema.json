{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commons.mncs.architecture-model/1",
  "title": "MNCS family architecture model",
  "type": "object",
  "required": ["schema_version", "schema_identity", "content_identity", "policy", "capabilities", "generators"],
  "properties": {
    "schema_version": {"const": "commons.mncs.architecture-model/1"},
    "schema_identity": {"const": "commons.mncs.architecture-model/1"},
    "content_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy": {"type": "object"},
    "capabilities": {"type": "array", "items": {"type": "object"}},
    "generators": {"type": "array", "items": {"type": "object"}}
  }
}
