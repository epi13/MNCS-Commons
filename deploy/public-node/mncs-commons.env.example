MNCS_COMMONS_PUBLIC_STORE=/var/lib/mncs-commons/public
MNCS_COMMONS_BIND=127.0.0.1
MNCS_COMMONS_PORT=8090
MNCS_COMMONS_WRITE_MODE=read-only
MNCS_COMMONS_BASE_URL=https://<hostname>
MNCS_COMMONS_NODE_ID=node:<hostname>
MNCS_COMMONS_VISIBILITY_POLICY=/etc/mncs-commons/visibility.json
MNCS_COMMONS_TRUSTED_PROXY_ADDRESSES=127.0.0.1
MNCS_COMMONS_MAX_LEDGER_ENTRIES=10000
MNCS_COMMONS_MAX_CONTENT_BYTES=268435456
